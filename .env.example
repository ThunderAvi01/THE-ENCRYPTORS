# ==============================================================================
# SIH 2026 (SIH26047) - Patient Case-Taking Software Environment Configuration
# ==============================================================================

# Application Configaration
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/sih_patient_case_taking
MONGODB_DB_NAME=sih_patient_case_taking

# Authentication (NextAuth.js / Auth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_secure_random_secret_with_openssl_rand_base64_32

# Storage (Cloudinary - Medical Documents Digitization)
# Note: AWS S3 is deferred as per architecture roadmap
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Layer Configuration (Agnostic Adapter Pattern)
# Supported Providers: "gemini" | "openai" | "anthropic" | "groq" | "ollama"
AI_PROVIDER=gemini
AI_API_KEY=your_ai_provider_api_key
AI_MODEL_NAME=gemini-1.5-pro
AI_BASE_URL=https://generativelanguage.googleapis.com

# Realtime & Telemetry (Planned for Phase 2/3)
NEXT_PUBLIC_SOCKET_SERVER_URL=http://localhost:3000

# Clinical Safety & Compliance
ENABLE_CLINICAL_AUDIT_LOGS=true
STRICT_NON_AUTONOMOUS_MODE=true

# Phase 7: Voice & Multilingual Case Taking Configuration
# Supported Voice Providers: "browser" (default) | "bhashini" | "openai"
NEXT_PUBLIC_VOICE_PROVIDER=browser

# Bhashini / AI4Bharat Indian Language Service Credentials (Optional)
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id

# OpenAI Whisper STT / TTS Credentials (Optional)
OPENAI_API_KEY=your_openai_api_key

